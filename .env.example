# דוגמה למשתני הסביבה של CartWise. אין כאן ערכים אמיתיים.
#
# שימו לב: אף רכיב לא קורא קובץ .env בשורש הריפו. הקובץ הזה הוא רק רשימה של המשתנים.
# ליד כל קבוצה כתוב איפה מגדירים אותה בפועל. מעתיקים משם רק את השורות הרלוונטיות.
#
# קובצי .env אמיתיים לא נכנסים ל-git (הריפו ציבורי). הערכים כאן הם ברירות המחדל של dev
# מקומי, או placeholder.

# --- backend ---
# איפה מגדירים: משתני סביבה ב-shell שבו מריצים את uvicorn או pytest, או ב-env של ה-CI.
# ה-backend לא קורא קובץ .env. ב-Docker, ה-compose ב-deploy/ מגדיר אותם ל-api בעצמו.
# לכולם יש ברירת מחדל ל-dev, כך שבפיתוח מקומי אין צורך להגדיר אותם.
#
# חיבור ל-Postgres. הערך הזה הוא של dev מקומי בלבד (לא סוד). כש-ENV=prod, ה-backend
# דוחה בדיוק את הערך הזה, ולכן ב-prod חובה להגדיר ערך אחר.
DATABASE_URL=postgresql+psycopg://cartwise:cartwise@localhost:5432/cartwise
# סביבה: dev, test או prod.
ENV=dev
# רמת לוג: DEBUG, INFO, WARNING, ERROR או CRITICAL.
LOG_LEVEL=INFO
# מפתח החתימה של device token לאורחים (JWT, HS256). הערך כאן הוא מפתח ה-dev הקבוע (לא סוד),
# וזו גם ברירת המחדל כשלא מגדירים אותו. כש-ENV=prod, ה-backend דוחה בדיוק את הערך הזה
# (וגם ערך קצר מ-32 תווים), ולכן ב-prod חובה להגדיר ערך אקראי וארוך, למשל: openssl rand -hex 32
DEVICE_TOKEN_SECRET=cartwise-dev-only-device-token-signing-key
# תוקף device token בימים (1 עד 365).
DEVICE_TOKEN_TTL_DAYS=30

# --- mobile ---
# איפה מגדירים: mobile/.env (ש-Expo טוען בעצמו), או משתנה סביבה ב-shell לפני npx expo start.
# כתובת ה-API מתוך האפליקציה. 10.0.2.2 הוא המחשב המארח, כפי שהוא נראה מהאמולטור של Android.
# במכשיר פיזי: כתובת ה-LAN של המחשב, למשל http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# --- build מקומי בלבד ---
# איפה מגדירים: deploy/.env (ש-docker compose טוען בתיקיית deploy/), או משתנה סביבה ב-shell.
# נתיב לקובץ תעודות CA נוסף, לבניית ה-image ברשת מסוננת (ראו deploy/README.md).
# ריק כברירת מחדל. לא נכנס ל-image.
CARTWISE_EXTRA_CA=
