    "/v1/admin/matches/{alias_id}/approve": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Approve Match",
        "description": "The match is final at once (FR-39), for product_id or the alias's current product. The\nchain's other final aliases of the same text move with it.",
        "operationId": "approve_match_v1_admin_matches__alias_id__approve_post",
        "parameters": [
          {
            "name": "alias_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Alias Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ApproveMatchIn"
                  },
                  {
                    "type": "null"
