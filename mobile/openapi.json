{
  "openapi": "3.1.0",
  "info": {
    "title": "CartWise API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/devices": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Register Device",
        "operationId": "register_device_v1_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegisterIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegisterOut"
                }
              }
            }
          },
          "200": {
            "description": "Device already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegisterOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/link": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Link",
        "description": "Link this device to the Google account behind the Firebase ID token (Bearer).",
        "operationId": "link_v1_auth_link_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LinkIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            }
          },
          "200": {
            "description": "User already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Me",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "identity"
        ],
        "summary": "Delete Me",
        "description": "Delete this registered account now (FR-6). Its row is purged 30 days later.",
        "operationId": "delete_me_v1_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "A guest (device token): account_required"
          }
        }
      }
    },
    "/v1/me/clubs": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Get My Clubs",
        "operationId": "get_my_clubs_v1_me_clubs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubIdsOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "identity"
        ],
        "summary": "Put My Clubs",
        "description": "Replace the whole set of clubs marked by this subject.",
        "operationId": "put_my_clubs_v1_me_clubs_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClubIdsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubIdsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/brands": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Get My Brands",
        "operationId": "get_my_brands_v1_me_brands_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyBrandsOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "identity"
        ],
        "summary": "Put My Brands",
        "description": "Replace the whole set of brands this subject wants.",
        "operationId": "put_my_brands_v1_me_brands_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrandIdsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyBrandsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/prefs": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Get My Prefs",
        "operationId": "get_my_prefs_v1_me_prefs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrefsOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "identity"
        ],
        "summary": "Put My Prefs",
        "description": "Save this subject's default range.",
        "operationId": "put_my_prefs_v1_me_prefs_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrefsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrefsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chains": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Chains",
        "operationId": "list_chains_v1_chains_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChainOut"
                  },
                  "type": "array",
                  "title": "Response List Chains V1 Chains Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/clubs": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Clubs",
        "operationId": "list_clubs_v1_clubs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClubOut"
                  },
                  "type": "array",
                  "title": "Response List Clubs V1 Clubs Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/brands/search": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Search Brands",
        "operationId": "search_brands_v1_brands_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BrandOut"
                  },
                  "title": "Response Search Brands V1 Brands Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/geocode": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Geocode",
        "description": "The coordinates of an address in Israel. The address is not kept or logged.",
        "operationId": "geocode_v1_geo_geocode_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeOut"
                }
              }
            }
          },
          "404": {
            "description": "address_not_found"
          },
          "503": {
            "description": "geocoding_unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrandIdsIn": {
        "properties": {
          "brand_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Brand Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brand_ids"
        ],
        "title": "BrandIdsIn"
      },
      "BrandOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "BrandOut"
      },
      "ChainOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ChainOut"
      },
      "ClubIdsIn": {
        "properties": {
          "club_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Club Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "club_ids"
        ],
        "title": "ClubIdsIn"
      },
      "ClubIdsOut": {
        "properties": {
          "club_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Club Ids"
          }
        },
        "type": "object",
        "required": [
          "club_ids"
        ],
        "title": "ClubIdsOut"
      },
      "ClubOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "chain_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chain Id"
          },
          "chain_name": {
            "type": "string",
            "title": "Chain Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "chain_id",
          "chain_name"
        ],
        "title": "ClubOut"
      },
      "DeviceRegisterIn": {
        "properties": {
          "install_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "title": "Install Id"
          }
        },
        "type": "object",
        "required": [
          "install_id"
        ],
        "title": "DeviceRegisterIn"
      },
      "DeviceRegisterOut": {
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Device Id"
          },
          "device_token": {
            "type": "string",
            "title": "Device Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "device_token",
          "expires_at"
        ],
        "title": "DeviceRegisterOut"
      },
      "GeocodeOut": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeocodeOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkIn": {
        "properties": {
          "device_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Token"
          }
        },
        "type": "object",
        "title": "LinkIn"
      },
      "LinkOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "LinkOut"
      },
      "MeOut": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "device"
            ],
            "title": "Kind"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "id"
        ],
        "title": "MeOut"
      },
      "MyBrandOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "MyBrandOut"
      },
      "MyBrandsOut": {
        "properties": {
          "brands": {
            "items": {
              "$ref": "#/components/schemas/MyBrandOut"
            },
            "type": "array",
            "title": "Brands"
          }
        },
        "type": "object",
        "required": [
          "brands"
        ],
        "title": "MyBrandsOut"
      },
      "PrefsIn": {
        "properties": {
          "default_mode": {
            "type": "string",
            "enum": [
              "walk",
              "car"
            ],
            "title": "Default Mode"
          },
          "default_minutes": {
            "type": "integer",
            "enum": [
              5,
              10,
              15,
              20,
              30
            ],
            "title": "Default Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "default_mode",
          "default_minutes"
        ],
        "title": "PrefsIn"
      },
      "PrefsOut": {
        "properties": {
          "default_mode": {
            "type": "string",
            "enum": [
              "walk",
              "car"
            ],
            "title": "Default Mode"
          },
          "default_minutes": {
            "type": "integer",
            "enum": [
              5,
              10,
              15,
              20,
              30
            ],
            "title": "Default Minutes"
          }
        },
        "type": "object",
        "required": [
          "default_mode",
          "default_minutes"
        ],
        "title": "PrefsOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
